[
 {
  "id": "a3-00",
  "type": "chapter",
  "title": "第三章《翻到包装背面》",
  "subtitle": "",
  "image": "ch_banner_3",
  "next": "a3-01"
 },
 {
  "id": "a3-01",
  "type": "say",
  "speaker": "米粒",
  "actor": "mili",
  "text": "你在给它找角度？",
  "scene": "class",
  "seg": 6,
  "channel": "stage",
  "next": "a3-02"
 },
 {
  "id": "a3-02",
  "type": "say",
  "speaker": "苏桃",
  "actor": "sutao",
  "text": "找字。这个位置刚好反光。",
  "scene": "class",
  "seg": 6,
  "channel": "stage",
  "next": "a3-03"
 },
 {
  "id": "a3-03",
  "type": "say",
  "speaker": "苏桃",
  "actor": "sutao",
  "text": "我一直把它记在奶那一栏。",
  "scene": "class",
  "seg": 6,
  "channel": "stage",
  "next": "a3-04"
 },
 {
  "id": "a3-04",
  "type": "say",
  "speaker": "你",
  "actor": null,
  "text": "先看看它具体是什么。",
  "scene": "class",
  "seg": 6,
  "channel": "stage",
  "next": "a3-05"
 },
 {
  "id": "a3-05",
  "type": "say",
  "speaker": "苏桃",
  "actor": "sutao",
  "text": "正面有一头奶牛，还有一大杯白色的东西。",
  "scene": "class",
  "seg": 6,
  "channel": "stage",
  "next": "a3-06",
  "prop": "product_front"
 },
 {
  "id": "a3-06",
  "type": "say",
  "speaker": "许知夏",
  "actor": "zhixia",
  "text": "看一下产品名称、配料表，再和奶的营养成分比较一下，会更清楚。",
  "scene": "class",
  "seg": 6,
  "channel": "stage",
  "next": "a3-07",
  "prop": "product_back"
 },
 {
  "id": "a3-07",
  "type": "say",
  "speaker": "苏桃",
  "actor": "sutao",
  "text": "等我拍下来。",
  "scene": "class",
  "seg": 6,
  "channel": "stage",
  "next": "a3-08"
 },
 {
  "id": "a3-08",
  "type": "say",
  "speaker": "米粒",
  "actor": "mili",
  "text": "第一次见你拍瓶子背面。",
  "scene": "class",
  "seg": 6,
  "channel": "stage",
  "next": "a3-09"
 },
 {
  "id": "a3-09",
  "type": "say",
  "speaker": "苏桃",
  "actor": "sutao",
  "text": "今天正面已经出过镜了，给背面一个机会。",
  "scene": "class",
  "seg": 6,
  "channel": "stage",
  "next": "a3-10"
 },
 {
  "id": "a3-10",
  "type": "choice",
  "question": "接下来怎么做？",
  "options": [
   {
    "text": "你买它的时候，主要想喝奶吗？",
    "next": "a3-11",
    "reply": [
     "一半是。另一半是瓶子好看。",
     "比例很诚实。",
     "我还觉得，既然名字里有“乳”，应该就能算每天那份奶。",
     "如果是想安排奶类，就要确认产品类型。含乳饮料不能直接替代奶。",
     "那我的记录得改一下。"
    ]
   }
  ]
 },
 {
  "id": "a3-11",
  "type": "say",
  "speaker": "你",
  "actor": null,
  "text": "你是因为喜欢它的味道才买的？",
  "scene": "class",
  "seg": 6,
  "channel": "stage",
  "next": "a3-12"
 },
 {
  "id": "a3-12",
  "type": "say",
  "speaker": "苏桃",
  "actor": "sutao",
  "text": "嗯，桃子味，我挺喜欢。",
  "scene": "class",
  "seg": 6,
  "channel": "stage",
  "next": "a3-13"
 },
 {
  "id": "a3-13",
  "type": "say",
  "speaker": "你",
  "actor": null,
  "text": "那把它按实际类别记成饮料。奶类再另外安排。",
  "scene": "class",
  "seg": 6,
  "channel": "stage",
  "next": "a3-14"
 },
 {
  "id": "a3-14",
  "type": "say",
  "speaker": "许知夏",
  "actor": "zhixia",
  "text": "对，先弄清它是什么，再考虑喝多少、放在哪一餐。",
  "scene": "class",
  "seg": 6,
  "channel": "stage",
  "next": "a3-15"
 },
 {
  "id": "a3-15",
  "type": "say",
  "speaker": "苏桃",
  "actor": "sutao",
  "text": "我之前是喝了一瓶饮料，顺便给自己的奶类记录盖了章。",
  "scene": "class",
  "seg": 6,
  "channel": "stage",
  "next": "a3-16"
 },
 {
  "id": "a3-16",
  "type": "say",
  "speaker": "你",
  "actor": null,
  "text": "先找一盒普通牛奶，对着看看。",
  "scene": "class",
  "seg": 6,
  "channel": "stage",
  "next": "a3-17"
 },
 {
  "id": "a3-17",
  "type": "say",
  "speaker": "周简",
  "actor": "zhoujian",
  "text": "目前桌上没有这个证据。",
  "scene": "class",
  "seg": 6,
  "channel": "stage",
  "next": "a3-18"
 },
 {
  "id": "a3-18",
  "type": "say",
  "speaker": "苏桃",
  "actor": "sutao",
  "text": "明天去便利店，我知道在哪排。",
  "scene": "class",
  "seg": 6,
  "channel": "stage",
  "next": "a3-19"
 },
 {
  "id": "a3-19",
  "type": "say",
  "speaker": "许知夏",
  "actor": "zhixia",
  "text": "可以。比较时先把“每100毫升”这一栏对齐。",
  "scene": "class",
  "seg": 6,
  "channel": "stage",
  "next": "a3-20",
  "prop": "nutrition"
 },
 {
  "id": "a3-20",
  "type": "say",
  "speaker": "米粒",
  "actor": "mili",
  "text": "别拿一瓶和一口比。",
  "scene": "class",
  "seg": 6,
  "channel": "stage",
  "next": "a3-21"
 },
 {
  "id": "a3-21",
  "type": "say",
  "speaker": "苏桃",
  "actor": "sutao",
  "text": "那明天去一趟。顺便给科普小组买点开会吃的东西。",
  "scene": "class",
  "seg": 6,
  "channel": "stage",
  "next": "a3-22"
 },
 {
  "id": "a3-22",
  "type": "say",
  "speaker": "你",
  "actor": null,
  "text": "群里说是下午碰面，三点半。",
  "scene": "class",
  "seg": 6,
  "channel": "stage",
  "next": "a3-23"
 },
 {
  "id": "a3-23",
  "type": "say",
  "speaker": "周简",
  "actor": "zhoujian",
  "text": "我列预算。",
  "scene": "class",
  "seg": 6,
  "channel": "stage",
  "next": "a3-24"
 },
 {
  "id": "a3-24",
  "type": "say",
  "speaker": "米粒",
  "actor": "mili",
  "text": "我负责带杯子。",
  "scene": "class",
  "seg": 6,
  "channel": "stage",
  "next": "a3-25"
 },
 {
  "id": "a3-25",
  "type": "say",
  "speaker": "陆燃",
  "actor": "luran",
  "text": "我提前到。",
  "scene": "class",
  "seg": 6,
  "channel": "stage",
  "next": "a3-26"
 },
 {
  "id": "a3-26",
  "type": "say",
  "speaker": "陆燃",
  "actor": "luran",
  "text": "这次我不说几分钟了。",
  "scene": "class",
  "seg": 6,
  "channel": "stage",
  "next": "a3-27"
 },
 {
  "id": "a3-27",
  "type": "say",
  "speaker": "你",
  "actor": null,
  "text": "今天早餐安排得怎么样？",
  "scene": "class",
  "seg": 7,
  "channel": "stage",
  "next": "a3-28"
 },
 {
  "id": "a3-28",
  "type": "say",
  "speaker": "米粒",
  "actor": "mili",
  "text": "吃上了。这次照片里有完整的食物。",
  "scene": "class",
  "seg": 7,
  "channel": "stage",
  "next": "a3-29"
 },
 {
  "id": "a3-29",
  "type": "say",
  "speaker": "米粒",
  "actor": "mili",
  "text": "我直接去便利店拿昨天选好的，没站在货架前想半天。",
  "scene": "class",
  "seg": 7,
  "channel": "stage",
  "next": "a3-30"
 },
 {
  "id": "a3-30",
  "type": "say",
  "speaker": "米粒",
  "actor": "mili",
  "text": "昨晚把能按包装要求常温保存的东西准备好了，早上拿起来就走。",
  "scene": "class",
  "seg": 7,
  "channel": "stage",
  "next": "a3-31"
 },
 {
  "id": "a3-31",
  "type": "say",
  "speaker": "米粒",
  "actor": "mili",
  "text": "今天食堂排队不长。星期三赶课那天，我就用备用方案。",
  "scene": "class",
  "seg": 7,
  "channel": "stage",
  "next": "a3-32"
 },
 {
  "id": "a3-32",
  "type": "say",
  "speaker": "你",
  "actor": null,
  "text": "来得及吃吗？份量感觉怎么样？",
  "scene": "class",
  "seg": 7,
  "channel": "stage",
  "next": "a3-33"
 },
 {
  "id": "a3-33",
  "type": "say",
  "speaker": "米粒",
  "actor": "mili",
  "text": "来得及。先这样试几天，有不合适的再改。",
  "scene": "class",
  "seg": 7,
  "channel": "stage",
  "next": "a3-34"
 },
 {
  "id": "a3-34",
  "type": "say",
  "speaker": "许知夏",
  "actor": "zhixia",
  "text": "好，记下实际情况就行。",
  "scene": "class",
  "seg": 7,
  "channel": "stage",
  "next": "a3-35"
 },
 {
  "id": "a3-35",
  "type": "say",
  "speaker": "米粒",
  "actor": "mili",
  "text": "酸奶我下午再看看，已经记在便签上了。",
  "scene": "class",
  "seg": 7,
  "channel": "stage",
  "next": "a3-36",
  "prop": "note"
 },
 {
  "id": "a3-36",
  "type": "say",
  "speaker": "你",
  "actor": null,
  "text": "今天准备怎么点餐？",
  "scene": "class",
  "seg": 7,
  "channel": "stage",
  "next": "a3-37"
 },
 {
  "id": "a3-37",
  "type": "say",
  "speaker": "陆燃",
  "actor": "luran",
  "text": "午饭正好用上昨天的方案，晚饭再按今天实际情况调整。",
  "scene": "class",
  "seg": 7,
  "channel": "stage",
  "next": "a3-38"
 },
 {
  "id": "a3-38",
  "type": "say",
  "speaker": "陆燃",
  "actor": "luran",
  "text": "鸡肉、米饭、青菜都点了。份量到窗口看着打。",
  "scene": "class",
  "seg": 7,
  "channel": "stage",
  "next": "a3-39"
 },
 {
  "id": "a3-39",
  "type": "say",
  "speaker": "陆燃",
  "actor": "luran",
  "text": "今天豆腐有，我点了米饭、豆腐和青菜。",
  "scene": "class",
  "seg": 7,
  "channel": "stage",
  "next": "a3-40"
 },
 {
  "id": "a3-40",
  "type": "say",
  "speaker": "陆燃",
  "actor": "luran",
  "text": "有蒸红薯。我买了一个，米饭相应少打一点，也点了鸡肉和蔬菜。",
  "scene": "class",
  "seg": 7,
  "channel": "stage",
  "next": "a3-41"
 },
 {
  "id": "a3-41",
  "type": "say",
  "speaker": "苏桃",
  "actor": "sutao",
  "text": "镜头终于拍到了盘子边缘。",
  "scene": "class",
  "seg": 7,
  "channel": "stage",
  "next": "a3-42"
 },
 {
  "id": "a3-42",
  "type": "say",
  "speaker": "陆燃",
  "actor": "luran",
  "text": "我专门站远了半步。",
  "scene": "class",
  "seg": 7,
  "channel": "stage",
  "next": "a3-43"
 },
 {
  "id": "a3-43",
  "type": "say",
  "speaker": "许知夏",
  "actor": "zhixia",
  "text": "这张记录清楚多了，吃完也记一下实际吃了多少。",
  "scene": "class",
  "seg": 7,
  "channel": "stage",
  "next": "a3-44"
 },
 {
  "id": "a3-44",
  "type": "say",
  "speaker": "陆燃",
  "actor": "luran",
  "text": "好。现在先吃，拍摄工作结束。",
  "scene": "class",
  "seg": 7,
  "channel": "stage",
  "next": "a3-45"
 },
 {
  "id": "a3-45",
  "type": "say",
  "speaker": "你",
  "actor": null,
  "text": "新组合买到了吗？",
  "scene": "class",
  "seg": 7,
  "channel": "stage",
  "next": "a3-46"
 },
 {
  "id": "a3-46",
  "type": "say",
  "speaker": "周简",
  "actor": "zhoujian",
  "text": "买到了，价格和菜单一致。",
  "scene": "class",
  "seg": 7,
  "channel": "stage",
  "next": "a3-47"
 },
 {
  "id": "a3-47",
  "type": "say",
  "speaker": "你",
  "actor": null,
  "text": "份量呢？",
  "scene": "class",
  "seg": 7,
  "channel": "stage",
  "next": "a3-48"
 },
 {
  "id": "a3-48",
  "type": "say",
  "speaker": "周简",
  "actor": "zhoujian",
  "text": "我拍了，吃完再记够不够。省下的钱也不会自动变成奶茶预算。",
  "scene": "class",
  "seg": 7,
  "channel": "stage",
  "next": "a3-49"
 },
 {
  "id": "a3-49",
  "type": "say",
  "speaker": "米粒",
  "actor": "mili",
  "text": "你为什么看起来像在提前回答我？",
  "scene": "class",
  "seg": 7,
  "channel": "stage",
  "next": "a3-50"
 },
 {
  "id": "a3-50",
  "type": "say",
  "speaker": "周简",
  "actor": "zhoujian",
  "text": "因为我了解这个群。",
  "scene": "class",
  "seg": 7,
  "channel": "stage",
  "next": "a3-51"
 },
 {
  "id": "a3-51",
  "type": "say",
  "speaker": "苏桃",
  "actor": "sutao",
  "text": "今天给它们拍合照。",
  "scene": "class",
  "seg": 8,
  "channel": "stage",
  "next": "a3-52"
 },
 {
  "id": "a3-52",
  "type": "say",
  "speaker": "你",
  "actor": null,
  "text": "背面朝前。",
  "scene": "class",
  "seg": 8,
  "channel": "stage",
  "next": "a3-53"
 },
 {
  "id": "a3-53",
  "type": "say",
  "speaker": "苏桃",
  "actor": "sutao",
  "text": "知道了，摄影要求已经变了。",
  "scene": "class",
  "seg": 8,
  "channel": "stage",
  "next": "a3-54"
 },
 {
  "id": "a3-54",
  "type": "say",
  "speaker": "你",
  "actor": null,
  "text": "一个写灭菌乳，一个写含乳饮料。",
  "scene": "class",
  "seg": 8,
  "channel": "stage",
  "next": "a3-55"
 },
 {
  "id": "a3-55",
  "type": "say",
  "speaker": "苏桃",
  "actor": "sutao",
  "text": "正面都有奶牛，背面分得倒很清楚。",
  "scene": "class",
  "seg": 8,
  "channel": "stage",
  "next": "a3-56"
 },
 {
  "id": "a3-56",
  "type": "say",
  "speaker": "许知夏",
  "actor": "zhixia",
  "text": "产品名称和类型能帮助我们确认买的是什么。包装图案只能提供一部分印象。",
  "scene": "class",
  "seg": 8,
  "channel": "stage",
  "next": "a3-57"
 },
 {
  "id": "a3-57",
  "type": "say",
  "speaker": "苏桃",
  "actor": "sutao",
  "text": "我以后先找这一行。",
  "scene": "class",
  "seg": 8,
  "channel": "stage",
  "next": "a3-58"
 },
 {
  "id": "a3-58",
  "type": "say",
  "speaker": "你",
  "actor": null,
  "text": "这盒纯牛奶的配料是生牛乳。饮料这边先写了水。",
  "scene": "class",
  "seg": 8,
  "channel": "stage",
  "next": "a3-59"
 },
 {
  "id": "a3-59",
  "type": "say",
  "speaker": "苏桃",
  "actor": "sutao",
  "text": "排在前面的，一般是放得更多的？",
  "scene": "class",
  "seg": 8,
  "channel": "stage",
  "next": "a3-60"
 },
 {
  "id": "a3-60",
  "type": "say",
  "speaker": "许知夏",
  "actor": "zhixia",
  "text": "通常按生产时加入量从多到少排列。不过少量配料有排列例外，不能光靠位置算出准确百分比。",
  "scene": "class",
  "seg": 8,
  "channel": "stage",
  "next": "a3-61"
 },
 {
  "id": "a3-61",
  "type": "say",
  "speaker": "周简",
  "actor": "zhoujian",
  "text": "所以可以看主要用了什么，不能自己给它编比例。",
  "scene": "class",
  "seg": 8,
  "channel": "stage",
  "next": "a3-62"
 },
 {
  "id": "a3-62",
  "type": "say",
  "speaker": "许知夏",
  "actor": "zhixia",
  "text": "对。",
  "scene": "class",
  "seg": 8,
  "channel": "stage",
  "next": "a3-63"
 },
 {
  "id": "a3-63",
  "type": "say",
  "speaker": "你",
  "actor": null,
  "text": "两份都写每100毫升，可以直接对比这一行。",
  "scene": "class",
  "seg": 8,
  "channel": "stage",
  "next": "a3-64"
 },
 {
  "id": "a3-64",
  "type": "say",
  "speaker": "苏桃",
  "actor": "sutao",
  "text": "3.2克和1.0克。",
  "scene": "class",
  "seg": 8,
  "channel": "stage",
  "next": "a3-65"
 },
 {
  "id": "a3-65",
  "type": "say",
  "speaker": "许知夏",
  "actor": "zhixia",
  "text": "这里买的两瓶都是250毫升。喝完整瓶，就分别约是8克和2.5克蛋白质。",
  "scene": "class",
  "seg": 8,
  "channel": "stage",
  "next": "a3-66"
 },
 {
  "id": "a3-66",
  "type": "say",
  "speaker": "苏桃",
  "actor": "sutao",
  "text": "这次差别看得挺明白。",
  "scene": "class",
  "seg": 8,
  "channel": "stage",
  "next": "a3-67"
 },
 {
  "id": "a3-67",
  "type": "say",
  "speaker": "许知夏",
  "actor": "zhixia",
  "text": "但判断一种食品，还要结合其他营养成分和你购买的目的。",
  "scene": "class",
  "seg": 8,
  "channel": "stage",
  "next": "a3-68"
 },
 {
