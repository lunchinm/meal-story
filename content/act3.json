  "scene": "class",
  "seg": 7,
  "next": "a3-24"
 },
 {
  "id": "a3-24",
  "type": "say",
  "speaker": "米粒",
  "actor": "mili",
  "text": "你为什么看起来像在提前回答我？",
  "scene": "class",
  "seg": 7,
  "next": "a3-25"
 },
 {
  "id": "a3-25",
  "type": "say",
  "speaker": "周简",
  "actor": "zhoujian",
  "text": "因为我了解这个群。",
