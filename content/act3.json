  "seg": 7,
  "next": "a3-26"
 },
 {
  "id": "a3-26",
  "type": "say",
  "speaker": "苏桃",
  "actor": "sutao",
  "text": "今天给它们拍合照。",
  "scene": "class",
  "seg": 8,
  "next": "a3-27"
 },
 {
  "id": "a3-27",
  "type": "say",
  "speaker": "苏桃",
  "actor": "sutao",
  "text": "知道了，摄影要求已经变了。",
  "scene": "class",
  "seg": 8,
  "next": "a3-28"
 },
 {
