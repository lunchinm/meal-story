[
 {
  "id": "a4-00",
  "type": "chapter",
  "title": "第四章《你的方案，能坚持吗》",
  "subtitle": "",
  "image": "ch_banner_4",
  "next": "a4-01"
 },
 {
  "id": "a4-01",
  "type": "say",
  "speaker": "米粒",
  "actor": "mili",
  "text": "我的早八已经成为公共资料了？",
  "scene": "class",
  "seg": 14,
  "next": "a4-02"
 },
 {
  "id": "a4-02",
  "type": "say",
  "speaker": "你",
  "actor": null,
  "text": "这里只保留吃饭时间和购买地点，其他课程信息可以遮掉。",
  "scene": "class",
  "seg": 14,
  "next": "a4-03"
 },
 {
  "id": "a4-03",
  "type": "say",
  "speaker": "米粒",
  "actor": "mili",
  "text": "那还行。尤其别把我找校园卡那五分钟印进去。",
  "scene": "class",
  "seg": 14,
  "next": "a4-04"
 },
 {
  "id": "a4-04",
  "type": "say",
  "speaker": "陆燃",
  "actor": "luran",
  "text": "我今天提前到了。",
  "scene": "class",
  "seg": 14,
  "next": "a4-05"
 },
 {
  "id": "a4-05",
  "type": "say",
  "speaker": "周简",
  "actor": "zhoujian",
  "text": "我们已经开始接受这个事实了。",
  "scene": "class",
  "seg": 14,
  "next": "a4-06"
 },
 {
  "id": "a4-06",
  "type": "say",
  "speaker": "周简",
  "actor": "zhoujian",
  "text": "但里面的信息影响了我们买什么。",
  "scene": "class",
  "seg": 14,
  "next": "a4-07"
 },
 {
  "id": "a4-07",
  "type": "say",
  "speaker": "你",
  "actor": null,
  "text": "先把三件实际能做的事写清楚。",
  "scene": "class",
  "seg": 14,
  "next": "a4-08"
 },
 {
  "id": "a4-08",
  "type": "say",
  "speaker": "米粒",
  "actor": "mili",
  "text": "这句话没问题。但如果明早我又只有十八分钟呢？",
  "scene": "class",
  "seg": 15,
  "next": "a4-09"
 },
 {
  "id": "a4-09",
  "type": "say",
  "speaker": "你",
  "actor": null,
  "text": "把在哪里买、什么时候准备写进去。",
  "scene": "class",
  "seg": 15,
  "next": "a4-10"
 },
 {
  "id": "a4-10",
  "type": "say",
  "speaker": "米粒",
  "actor": "mili",
  "text": "我这次是直接去便利店拿选好的东西，确实快。",
  "scene": "class",
  "seg": 15,
  "next": "a4-11"
 },
 {
  "id": "a4-11",
  "type": "say",
  "speaker": "你",
  "actor": null,
  "text": "那就写清楚最近的购买点。再留一个排队太长时的备用方案。",
  "scene": "class",
  "seg": 15,
  "next": "a4-12"
 },
 {
  "id": "a4-12",
  "type": "say",
  "speaker": "米粒",
  "actor": "mili",
  "text": "能提前准备的东西，前一晚放好。我前一天准备好了，早上省事。",
  "scene": "class",
  "seg": 15,
  "next": "a4-13"
 },
 {
  "id": "a4-13",
  "type": "choice",
  "question": "接下来怎么做？",
  "options": [
   {
    "text": "把它写成两种可以切换的安排。",
    "next": "a4-14"
   }
  ]
 },
 {
  "id": "a4-14",
  "type": "say",
  "speaker": "许知夏",
  "actor": "zhixia",
  "text": "我们也把午饭、晚饭和加餐留在一天的安排里。早餐有了计划，全天仍要一起看。",
  "scene": "class",
  "seg": 15,
  "next": "a4-15"
 },
 {
  "id": "a4-15",
  "type": "say",
  "speaker": "米粒",
  "actor": "mili",
  "text": "这张看着有希望执行。",
  "scene": "class",
  "seg": 15,
  "next": "a4-16"
 },
 {
  "id": "a4-16",
  "type": "say",
  "speaker": "罗师傅",
  "actor": "luomaster",
  "text": "补充一下，明天鸡肉那道暂停一天，有鱼和豆腐。青菜照常供应。",
  "scene": "class",
  "seg": 16,
  "next": "a4-17"
 },
 {
  "id": "a4-17",
  "type": "say",
  "speaker": "周简",
  "actor": "zhoujian",
  "text": "刚好。旧方案不能原样用了。",
  "scene": "class",
  "seg": 16,
  "next": "a4-18"
 },
 {
  "id": "a4-18",
  "type": "say",
  "speaker": "陆燃",
  "actor": "luran",
  "text": "昨天我才把鸡肉安排明白。",
  "scene": "class",
  "seg": 16,
  "next": "a4-19"
 },
 {
  "id": "a4-19",
  "type": "say",
  "speaker": "米粒",
  "actor": "mili",
  "text": "你的菜单开始出现剧情分支了。",
  "scene": "class",
  "seg": 16,
  "next": "a4-20"
 },
 {
  "id": "a4-20",
  "type": "say",
  "speaker": "周简",
  "actor": "zhoujian",
  "text": "午饭预算还是十二元。",
  "scene": "class",
  "seg": 16,
  "next": "a4-21"
 },
 {
  "id": "a4-21",
  "type": "choice",
  "question": "接下来怎么做？",
  "options": [
   {
    "text": "米饭＋时蔬＋豆腐＋鸡蛋，共11元",
    "next": "a4-22",
    "reply": "这个在预算里，也都是明天有的。"
   }
  ]
 },
 {
  "id": "a4-22",
  "type": "say",
  "speaker": "米粒",
  "actor": "mili",
  "text": "土豆丝成功留在了你的长期规划里。",
  "scene": "class",
  "seg": 16,
  "next": "a4-23"
 },
 {
  "id": "a4-23",
  "type": "say",
  "speaker": "周简",
  "actor": "zhoujian",
  "text": "喜欢的食物值得认真安排。",
  "scene": "class",
  "seg": 16,
  "next": "a4-24"
 },
 {
  "id": "a4-24",
  "type": "say",
  "speaker": "苏桃",
  "actor": "sutao",
  "text": "上午又拍到两盒。想把它们放进指南里，让大家试着看。",
  "scene": "class",
  "seg": 17,
  "next": "a4-25"
 },
 {
  "id": "a4-25",
  "type": "say",
  "speaker": "米粒",
  "actor": "mili",
  "text": "B的每100毫升比较多。",
  "scene": "class",
  "seg": 17,
  "next": "a4-26"
 },
 {
  "id": "a4-26",
  "type": "say",
  "speaker": "你",
  "actor": null,
  "text": "但两盒大小不一样。",
  "scene": "class",
  "seg": 17,
  "next": "a4-27"
 },
 {
  "id": "a4-27",
  "type": "say",
  "speaker": "苏桃",
  "actor": "sutao",
  "text": "对，这次我们已经会先看表头了。",
  "scene": "class",
  "seg": 17,
  "next": "a4-28"
 },
 {
  "id": "a4-28",
  "type": "choice",
  "question": "接下来怎么做？",
  "options": [
   {
    "text": "在图片下面补上每盒的换算。",
    "next": "a4-29"
   }
  ]
 },
 {
  "id": "a4-29",
  "type": "say",
  "speaker": "陆燃",
  "actor": "luran",
  "text": "喝完整盒，A这盒反而多一点。",
  "scene": "class",
  "seg": 17,
  "next": "a4-30"
 },
 {
  "id": "a4-30",
  "type": "say",
  "speaker": "苏桃",
  "actor": "sutao",
  "text": "那我配三个动作。",
  "scene": "class",
  "seg": 17,
  "next": "a4-31"
 },
 {
  "id": "a4-31",
  "type": "say",
  "speaker": "许知夏",
  "actor": "zhixia",
  "text": "再保留来源入口，方便想继续看的人查。",
  "scene": "class",
  "seg": 17,
  "next": "a4-32"
 },
 {
  "id": "a4-32",
  "type": "say",
  "speaker": "苏桃",
  "actor": "sutao",
  "text": "这里还放得下一张小卡。写什么？",
  "scene": "class",
  "seg": 18,
  "next": "a4-33"
 },
 {
  "id": "a4-33",
  "type": "say",
  "speaker": "你",
  "actor": null,
  "text": "我们要不要先选一个人，看看这份指南对他具体怎么用？",
  "scene": "class",
  "seg": 18,
  "next": "a4-34"
 },
 {
  "id": "a4-34",
  "type": "choice",
  "question": "接下来怎么做？",
  "options": [
   {
    "text": "先把适用情况写清楚，再整理通用版本。",
    "next": "a4-35"
   }
  ]
 },
 {
  "id": "a4-35",
  "type": "say",
  "speaker": "你",
  "actor": null,
  "text": "把之前的回访对象请来，再核对一下条件。明天的课表和购买路线，还是之前那样吗？",
  "scene": "class",
  "seg": 18,
  "next": "a4-36"
 },
 {
  "id": "a4-36",
  "type": "say",
  "speaker": "你",
  "actor": null,
  "text": "早餐想保留什么？有没有不方便吃的？",
  "scene": "class",
  "seg": 18,
  "next": "a4-37"
 },
 {
  "id": "a4-37",
  "type": "say",
  "speaker": "你",
  "actor": null,
  "text": "明天还是训练日吗？",
  "scene": "class",
  "seg": 18,
  "next": "a4-38"
 },
 {
  "id": "a4-38",
  "type": "say",
  "speaker": "你",
  "actor": null,
  "text": "最后加上资料来源和更新日期。",
  "scene": "class",
  "seg": 18,
  "next": "a4-39"
 },
 {
  "id": "a4-39",
  "type": "say",
  "speaker": "苏桃",
  "actor": "sutao",
  "text": "好，排版完成以后我再检查一次，别把来源挤得看不见。",
  "scene": "class",
  "seg": 18,
  "next": "a4-40"
 },
 {
  "id": "a4-40",
  "type": "say",
  "speaker": "你",
  "actor": null,
  "text": "内容已经核对完了。接下来怎么用？",
  "scene": "class",
  "seg": 19,
  "next": "a4-41"
 },
 {
  "id": "a4-41",
  "type": "choice",
  "question": "接下来怎么做？",
  "options": [
   {
    "text": "先发出这版通用指南，给大家作参考。",
    "next": "a4-42"
   }
  ],
  "next": "a4-it"
 },
