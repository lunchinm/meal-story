  "scene": "class",
  "seg": 19,
  "next": "a4-68"
 },
 {
  "id": "a4-68",
  "type": "say",
  "speaker": "周简",
  "actor": "zhoujian",
  "text": "我愿意提供小票。",
  "scene": "class",
  "seg": 19,
  "next": "a4-69"
 },
 {
  "id": "a4-69",
  "type": "say",
  "speaker": "苏桃",
  "actor": "sutao",
  "text": "怎么大家突然都很熟练。",
  "scene": "class",
  "seg": 19,
  "next": "a4-70"
 },
 {
  "id": "a4-70",
  "type": "say",
